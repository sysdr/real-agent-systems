# Provider: replay (default, offline) | stub | live
RELAY_PROVIDER=replay
# Live mode only
ANTHROPIC_API_KEY=
RELAY_MODEL=
RELAY_MAX_OUTPUT_TOKENS=1024
# Agent loop caps (Day 02): model calls per task, and total tokens across all calls
RELAY_MAX_STEPS=6
RELAY_MAX_TOKENS=8000
# Structured logs on stderr: WARNING (default) | INFO shows every model call and tool result
RELAY_LOG_LEVEL=WARNING
# Optional, to see real cost on the scoreboard (USD per million tokens)
RELAY_PRICE_IN_PER_MTOK=0
RELAY_PRICE_OUT_PER_MTOK=0
NORTHWIND_PORT=8701
RELAY_USE_DOCKER=auto
